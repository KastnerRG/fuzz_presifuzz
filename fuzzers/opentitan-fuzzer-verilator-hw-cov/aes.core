CAPI=2:
# Copyright lowRISC contributors.
# SPDX-License-Identifier: Apache-2.0
name: "presifuzz:ip:aes:0.6"
description: "PreSiFuzz OpenTitan AES testbench with toggle coverage"

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:all
      - lowrisc:prim:lfsr
      - lowrisc:ip:tlul
    files:
      - rtl/aes_pkg.sv
      - rtl/aes_reg_pkg.sv
      - rtl/aes_reg_top.sv
      - tb/aes_core.sv
      - rtl/aes_ctr.sv
      - rtl/aes_control.sv
      - rtl/aes_reg_status.sv
      - rtl/aes_cipher_core.sv
      - rtl/aes_cipher_control.sv
      - rtl/aes_sub_bytes.sv
      - rtl/aes_sbox.sv
      - rtl/aes_sbox_lut.sv
      - rtl/aes_sbox_canright_pkg.sv
      - rtl/aes_sbox_canright.sv
      - rtl/aes_sbox_canright_masked_noreuse.sv
      - rtl/aes_sbox_canright_masked.sv
      - rtl/aes_shift_rows.sv
      - rtl/aes_mix_columns.sv
      - rtl/aes_mix_single_column.sv
      - rtl/aes_key_expand.sv
      - rtl/aes_prng_clearing.sv
      - rtl/aes_prng_masking.sv
      - rtl/aes.sv
      - tb/aes_tb.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/aes.vlt
    file_type: vlt

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  syn:
    default_tool: verilator
    filesets:
      - files_verilator_waiver
      - files_rtl
    parameters:
      - SYNTHESIS=true
    toplevel: aes_tb
